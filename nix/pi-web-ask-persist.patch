+/**
+ * The newest question set that no answer or skip has resolved yet.
+ *
+ * Deliberately not "the question at the tail": anything appended after a set —
+ * the human's own next message, a phase-completion follow-up, a subsession
+ * notice, a tool boundary — would otherwise collapse the form into a card with
+ * no controls, record no outcome, and tell the model nothing, silently dropping
+ * questions the human never answered. The backend already resolves an ask from
+ * anywhere on the branch (`submitAsk`: "Reply to a durable question entry, even
+ * after later conversation or replies"), so keeping the newest unresolved set
+ * live at its own transcript position uses the durability the protocol has.
+ *
+ * Only the newest set opens, so a conversation never shows two live forms, and an
+ * older unanswered set is not resurrected once a newer one was answered.
+ *
+ * The page gates stay: the question must be reachable from the loaded tail of the
+ * active conversation (not a page that stops short of it) and the session must be
+ * writable.
+ */
 export function openTranscriptQuestion(messages: readonly ChatLine[], context: QuestionTailContext): AskUserRequest | undefined {
   if (!context.historyReady || !context.writable || context.messageEnd < context.messageTotal) return undefined;
-  const last = messages.at(-1)?.parts.at(-1);
-  return last?.type === "askUserQuestion" ? last.ask : undefined;
+  const newest = newestQuestion(messages);
+  if (newest === undefined) return undefined;
+  return transcriptQuestionOutcomes(messages).has(newest.askId) ? undefined : newest;
+}
+
+function newestQuestion(messages: readonly ChatLine[]): AskUserRequest | undefined {
+  for (let messageIndex = messages.length - 1; messageIndex >= 0; messageIndex -= 1) {
+    const parts = messages[messageIndex]?.parts ?? [];
+    for (let partIndex = parts.length - 1; partIndex >= 0; partIndex -= 1) {
+      const part = parts[partIndex];
+      if (part?.type === "askUserQuestion") return part.ask;
+    }
+  }
+  return undefined;
 }
 
 /** Responses remain separate transcript facts; none is treated as stale. */
