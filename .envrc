use flake

# Capture the real pi before bin/ shadows PATH: bin/pi is a wrapper that runs
# pi with `-ne` + explicit local extensions, so pi in this repo never loads the
# globally-installed (Nix-built) copies of the same extensions.
export PI_WRAPPER_REAL_PI="$(command -v pi)"
# Point spawned agents (see src/spawn.ts resolvePiBinary) at the local wrapper
# too: belayd subagents run `pi --mode json` inside the repo/worktree and would
# otherwise use /run/current-system/sw/bin/pi and dual-load the extensions.
export PI_BINARY_PATH="$(pwd)/bin/pi"
PATH_add bin