{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    // The aws-broker entry points (src/aws-broker/main.ts, client.ts) are run
    // directly by Node 24's native type stripping from the Nix wrappers, which
    // resolves only the literal specifier. Those files therefore import
    // `./x.ts`; tsc rewrites the extension to `.js` on emit so `dist/` stays
    // valid for library consumers. Everything else keeps the usual `.js`
    // specifiers.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "extensions", "pi-web-plugins"],
  "exclude": []
}
