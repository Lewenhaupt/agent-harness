#!/usr/bin/env bash
# pi for THIS repo: load only the repo-local extensions.
#
# The NixOS config (nix-tmp/modules/core/belayd-pi-web.nix) installs the same
# harness extensions globally at ~/.pi/agent/extensions/belayd-*.ts, built from
# the pushed flake. The extension factories self-dedupe on a process-wide
# marker (extensions/index.ts, stale-file-guard.ts, worktree-guard.ts), so a
# double load no longer fails — but whichever copy loads first wins, and global
# extensions load before project-local ones, so plain `pi` here would run the
# Nix-built copy and silently ignore edits to extensions/.
#
# `-ne` disables extension discovery and pi's built-in extensions (explicit -e
# paths still work), so the local extensions are re-added explicitly with -e
# and always win. This keeps the dev loop
# local: edits to extensions/ take effect on the next pi start, with no push
# + OS rebuild.
#
# The -e list is DERIVED, never hand-maintained:
# - harness entry points come from package.json `pi.extensions`;
# - third-party entry points come from nix/pi-extensions/package.json
#   `piExtensions`, resolved against $BELAYD_PI_EXTENSIONS_DIR (the Nix-built
#   node_modules tree the devShell exports).
# When that tree is absent (running outside the devShell) the third-party set
# falls back to npm specs with a warning, because pi can only resolve those
# from the registry.
#
# `.envrc` captures the real pi path in PI_WRAPPER_REAL_PI before prepending
# bin/ to PATH, so this script never re-executes itself.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

real_pi="${PI_WRAPPER_REAL_PI:-$(command -v pi || true)}"
if [[ -z "$real_pi" ]]; then
  echo "pi: cannot locate the real pi binary" >&2
  exit 1
fi

# pi CLI subcommands. pi expects these as the FIRST argument; prepending the
# -ne/-e flags below would push e.g. "pi install foo" into treating
# "install foo" as an agent prompt. Pass subcommands through untouched so they
# operate on the real user/global settings.
case "${1:-}" in
  install|remove|uninstall|update|list|config|auth)
    exec "$real_pi" "$@"
    ;;
esac

# Resolve extension entry points from the two manifests. Node is always present
# (pi itself is a node program), so this needs no jq.
extension_args="$(
  node - "$repo_dir" "${BELAYD_PI_EXTENSIONS_DIR:-}" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const [repoDir, thirdPartyDir] = process.argv.slice(2);

const readJson = (file) => JSON.parse(fs.readFileSync(file, "utf8"));
const harnessManifest = readJson(path.join(repoDir, "package.json"));
const thirdPartyManifest = readJson(path.join(repoDir, "nix/pi-extensions/package.json"));

const args = [];
const missing = [];

for (const entry of harnessManifest.pi?.extensions ?? []) {
  const rel = entry.replace(/^\.\//, "");
  const abs = path.join(repoDir, rel);
  if (!fs.existsSync(abs)) missing.push(abs);
  args.push("-e", abs);
}

const entries = thirdPartyManifest.piExtensions ?? {};
const deps = thirdPartyManifest.dependencies ?? {};
const thirdPartyRoot =
  thirdPartyDir !== "" && fs.existsSync(thirdPartyDir) ? thirdPartyDir : undefined;

for (const [name, entryPath] of Object.entries(entries)) {
  if (thirdPartyRoot !== undefined) {
    const abs = path.join(thirdPartyRoot, name, entryPath);
    if (!fs.existsSync(abs)) missing.push(abs);
    args.push("-e", abs);
    continue;
  }
  // No Nix-built tree: fall back to the registry spec from the manifest.
  const spec = deps[name] ?? "latest";
  process.stderr.write(
    `pi: BELAYD_PI_EXTENSIONS_DIR is unset or missing; loading ${name}@${spec} from npm ` +
      "(start pi inside the devShell for the pinned, offline tree)\n",
  );
  args.push("-e", `npm:${name}@${spec}`);
}

if (missing.length > 0) {
  process.stderr.write(`pi: manifest names missing extension paths:\n  ${missing.join("\n  ")}\n`);
  process.exit(1);
}
process.stdout.write(args.join("\n"));
NODE
)"

# mapfile keeps paths with spaces intact (word splitting would break them).
mapfile -t ext_args <<<"$extension_args"

exec "$real_pi" -ne "${ext_args[@]}" "$@"
