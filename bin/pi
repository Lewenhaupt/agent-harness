#!/usr/bin/env bash
# pi for THIS repo: load only the repo-local extensions.
#
# The NixOS config (nix-tmp/modules/core/belayd-pi-web.nix) installs the same
# harness extensions globally at ~/.pi/agent/extensions/belayd-*.ts, built from
# the pushed flake. Running plain `pi` in this repo then loads those global
# copies AND the ones declared in .pi/settings.json, and every belayd_* tool
# registration fails with:
#
#   Error: Failed to load extension "~/.pi/agent/extensions/belayd-harness.ts":
#          Tool "belayd_scout" conflicts with .../extensions/index.ts
#
# `-ne` disables ALL extension discovery (global dirs AND the settings
# `extensions`/`packages` arrays — verified by test), so the local extensions
# are re-added explicitly with -e. This keeps the dev loop local: edits to
# extensions/ take effect on the next pi start, with no push + OS rebuild.
#
# `.envrc` captures the real pi path in PI_WRAPPER_REAL_PI before prepending
# bin/ to PATH, so this script never re-executes itself.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

real_pi="${PI_WRAPPER_REAL_PI:-$(command -v pi || true)}"
if [[ -z "$real_pi" ]]; then
  echo "pi: cannot locate the real pi binary" >&2
  exit 1
fi

exec "$real_pi" -ne \
  -e "$repo_dir/extensions/index.ts" \
  -e "$repo_dir/extensions/stale-file-guard.ts" \
  -e "$repo_dir/extensions/worktree-guard.ts" \
  "$@"