[0.000, "o", "\r\n========== 6. BEHAVIOUR 4: a hinted reset is authoritative and clears the ladder ==========\r\n\r\n"]
[0.000, "o", "live hinted body: Model response failed: 429: {\"type\":\"GoUsageLimitError\",\"message\":\"Weekly usage limit reached. Resets in 20min.\"}\r\n\r\n"]
