[0.002, "o", "feat/bd-38\r\n"]
[0.000, "o", "(exit 0)\r\n\r\n$ git rev-parse --short HEAD\r\n"]
[0.001, "o", "cb66e9d\r\n"]
[0.000, "o", "(exit 0)\r\n\r\n"]
[0.000, "o", "$ git status --short\r\n"]
