[0.003, "o", "-rw-r--r-- 1 hugo users 13350 okt 27 14:07 dist/src/capacity-cache.js\r\n-rw-r--r-- 1 hugo users 23429 okt 27 14:07 dist/src/model-cooldown.js\r\n-rw-r--r-- 1 hugo users 18827 okt 27 14:07 dist/src/quota-failure.js\r\n-rw-r--r-- 1 hugo users 13448 okt 27 14:07 dist/src/spawn-with-fallback.js\r\n"]
[0.000, "o", "\r\n\r\n========== 2. BEHAVIOUR 1+2: unhinted provider 429 -> 6 h; a reset hint still wins ==========\r\n\r\n"]
[0.000, "o", "$ node /tmp/bd38-proof/01-resolve.mjs\r\n"]
[0.036, "o", "constants: DEFAULT_QUOTA_COOLDOWN_SECONDS=900s  DEFAULT_PROVIDER_USAGE_LIMIT_COOLDOWN_SECONDS=21600s (6h)\r\n"]
[0.001, "o", "\r\n"]
[0.000, "o", "bd-38 live body (unhinted)\r\n  body                : Model response failed: 429: {\"type\":\"GoUsageLimitError\",\"message\":\"Go usage limit exceeded\"}\r\n  classifySpawnFailure: kind=quota cooldownSeconds=21600 cooldownHinted=false\r\n"]
[0.000, "o", "  resolveQuotaCooldown: {\"cooldownSeconds\":21600,\"cooldownHinted\":false}\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "bd-38 hinted long (7hr 57min)\r\n  body                : Model response failed: 429: {\"type\":\"GoUsageLimitError\",\"message\":\"Weekly usage limit reached. R\r\n"]
[0.000, "o", "  classifySpawnFailure: kind=quota cooldownSeconds=28620 cooldownHinted=true\r\n"]
[0.000, "o", "  resolveQuotaCooldown: {\"cooldownSeconds\":28620,\"cooldownHinted\":true}\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "bd-38 hinted short (20min)\r\n"]
[0.000, "o", "  body                : Model response failed: 429: {\"type\":\"GoUsageLimitError\",\"message\":\"Weekly usage limit reached. R\r\n"]
[0.000, "o", "  classifySpawnFailure: kind=quota cooldownSeconds=1200 cooldownHinted=true\r\n"]
[0.000, "o", "  resolveQuotaCooldown: {\"cooldownSeconds\":1200,\"cooldownHinted\":true}\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "unchanged default (400, no quota wording)\r\n"]
[0.000, "o", "  body                : 400: bad request\r\n"]
[0.000, "o", "  classifySpawnFailure: kind=other cooldownSeconds=undefined cooldownHinted=undefined\r\n"]
[0.000, "o", "  resolveQuotaCooldown: {\"cooldownSeconds\":900,\"cooldownHinted\":false}\r\n"]
[0.000, "o", "\r\n"]
[0.004, "o", "(exit 0)\r\n\r\n\r\n========== 3. BEHAVIOUR 3: escalation ladder on repeated unhinted 429s (one process per mark) ==========\r\n\r\n"]
