[0.003, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"providers\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"opencode-go\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"until\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1793107669835\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Quota/credit/rate limit (HTTP 429).\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastMarkedAt\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1793106469835\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"escalations\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"opencode-go\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"count\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"lastMarkedAt\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1793106469835\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
