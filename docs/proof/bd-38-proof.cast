[0.000, "o", "\r\n\r\n========== 7. BEHAVIOUR 5: cross-process freshness (the fleet symptom) - two node processes, one file ==========\r\n\r\n"]
[0.002, "o", "scratch cooldown file: /tmp/bd38-proof/fleet.json\r\nB starts first over an EMPTY file (background); A writes 6 h (foreground).\r\n\r\n"]
[0.000, "o", "$ node /tmp/bd38-proof/fleet-b.mjs /tmp/bd38-proof/a-wrote\r\n"]
